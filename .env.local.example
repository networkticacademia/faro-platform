# Copie este archivo como .env.local y complete los valores reales.
# .env.local NO se sube a git (ya está en .gitignore por defecto de Next.js).

# Supabase — proyecto "faro-m0"
NEXT_PUBLIC_SUPABASE_URL=https://sayyvetazovpxjtlklqg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_NAczUzNmXD0junmZZumI3g_m6SCD2K6

# Service role — SOLO en el entorno de servidor (Vercel env vars), NUNCA en el navegador
# ni compartida por chat. Se obtiene en Supabase > Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — orquestador (Claude Sonnet 4.6 para el MVP, un solo modelo)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
